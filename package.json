{
  "name": "music-filter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "build": "npm run build:worklet && npm run build:separator",
    "build:dpdf": "bash scripts/build-dpdf.sh",
    "fetch:models": "bash scripts/fetch-models.sh",
    "build:worklet": "esbuild src/worklet/processor.js --bundle --format=esm --outfile=extension/dist/processor.js",
    "build:separator": "node scripts/build-separator.mjs",
    "test:e2e": "npm run build && node test/e2e/live.e2e.mjs && node test/e2e/read-ahead.e2e.mjs",
    "package": "node scripts/package.mjs",
    "package:safari": "bash scripts/package-safari.sh",
    "render:icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "playwright": "1.49.1"
  },
  "dependencies": {
    "opus-decoder": "0.7.12"
  }
}
