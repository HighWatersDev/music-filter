{
  "name": "music-filter",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "build": "npm run build:worklet && npm run build:separator",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:worklet": "esbuild src/worklet/processor.js --bundle --format=esm --outfile=extension/dist/processor.js",
    "build:separator": "node scripts/build-separator.mjs",
    "bench": "node bench/node-bench.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  },
  "dependencies": {
    "@audio/neural-runtime": "0.2.0",
    "@audio/neural-separate": "0.7.0",
    "onnxruntime-web": "1.30.0",
    "opus-decoder": "0.7.12"
  }
}
