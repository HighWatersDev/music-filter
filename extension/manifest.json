{
  "manifest_version": 3,
  "name": "Music Filter",
  "version": "1.0.2",
  "description": "Removes background music from YouTube videos and keeps the voices. Runs on your device. Nothing is uploaded.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "http://localhost/*"
      ],
      "js": [
        "mse-tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "http://localhost/*"
      ],
      "js": [
        "dist/read-ahead.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/processor.js",
        "assets/dpdf_bg.wasm",
        "assets/dpdfnet4.onnx",
        "assets/dpdfnet2.onnx",
        "separator.html",
        "dist/separator-frame.js",
        "dist/separator-worker.js",
        "dist/filter-worker.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "http://localhost/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
