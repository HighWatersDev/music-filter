{
  "manifest_version": 3,
  "name": "Music Filter Spike",
  "version": "0.1.0",
  "description": "Spike: remove background music from video audio in the browser.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "http://localhost/*"
      ],
      "js": [
        "mse-tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "http://localhost/*"
      ],
      "js": [
        "dist/read-ahead.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/processor.js",
        "assets/*",
        "clip-recorder.js",
        "separator.html",
        "dist/separator-frame.js",
        "dist/separator-worker.js",
        "dist/ort/*"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "http://localhost/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
